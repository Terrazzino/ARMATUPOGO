# =====================================================================
# ARMA TU POGO - VARIABLES PARA ENTORNO E2E LOCAL AISLADO (Clase 13 MDW)
# =====================================================================
#
# Este archivo define la plantilla de variables para ejecutar pruebas
# Playwright contra un entorno local 100% independiente de producción.
#
# Flujo de uso:
#   1. Copiar este archivo como .env.e2e (archivo ignorado por git):
#        copy .env.e2e.example .env.e2e
#   2. Con Docker en ejecución, iniciar Supabase Local:
#        npx supabase start
#   3. Obtener las credenciales locales de la instancia:
#        npx supabase status -o env
#   4. Completar en tu .env.e2e local la NEXT_PUBLIC_SUPABASE_ANON_KEY obtenida.
#   5. Aplicar migraciones Prisma sobre la base PostgreSQL local:
#        npm run prisma:migrate:e2e
#   6. Ejecutar la suite E2E aislada en puerto 3100:
#        npm run test:e2e

PORT=3100

# 1. Base de datos PostgreSQL local para E2E (puerto 54322 por defecto en Supabase local):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# 2. Supabase Auth y Storage Local (puerto 54321 por defecto en Supabase local):
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# Placeholders de ejemplo. Reemplazar en tu .env.e2e local con los valores entregados por `npx supabase status -o env`:
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJpYXQiOjE2MDAwMDAwMDAsImV4cCI6MjAwMDAwMDAwMH0.M1m_example_key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTYwMDAwMDAwMCwiZXhwIjoyMDAwMDAwMDAwfQ.M1m_example_service_role_key"

# 3. URL de la aplicación Next.js local E2E (puerto exclusivo 3100):
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3100"
PLAYWRIGHT_TEST_BASE_URL="http://127.0.0.1:3100"
