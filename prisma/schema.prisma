// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RolUsuario {
  MUSICO
  ORGANIZADOR
}

enum EstadoEvento {
  BORRADOR
  PUBLICADO
  EN_CURSO
  COMPLETADO
  CANCELADO
}

enum EstadoContratacion {
  PENDIENTE
  NEGOCIANDO
  ACORDADO
  CANCELADO
  COMPLETADO
  RECHAZADO
}

enum EstadoOferta {
  PROPUESTA
  ACEPTADA
  RECHAZADA
  CONTRAOFERTADA
}

model Usuario {
  id           String     @id @db.Uuid
  email        String     @unique
  nombre       String     @map("first_name")
  apellido     String     @map("last_name")
  rol          RolUsuario @map("role")
  fotoPerfilUrl String?   @map("avatar_url")
  biografia    String?    @map("bio")
  telefono     String?    @map("phone")
  creadoEn     DateTime   @default(now()) @map("created_at")
  actualizadoEn DateTime  @updatedAt @map("updated_at")

  // Relaciones
  proyectos            ProyectoMusical[]
  eventos              Evento[]
  contratosOrganizador Contratacion[]    @relation("ContratosOrganizador")
  contratosMusico      Contratacion[]    @relation("ContratosMusico")
  contratosCreados     Contratacion[]    @relation("ContratosCreados")
  ofertasEnviadas      Oferta[]
  valoracionesDadas    Valoracion[]      @relation("ValoracionesDadas")
  valoracionesRecibidas Valoracion[]     @relation("ValoracionesRecibidas")

  @@map("usuarios")
}

model ProyectoMusical {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId             String    @map("user_id") @db.Uuid
  nombre                String    @map("name")
  descripcion           String?   @map("description")
  genero                String    @map("genre")
  cacheAproximado       Decimal?  @map("approximate_cache") @db.Decimal(12, 2)
  ubicacion             String?   @map("location")
  ciudad                String?   @map("city")
  imagenUrl             String?   @map("image_url")
  spotifyUrl            String?   @map("spotify_url")
  youtubeUrl            String?   @map("youtube_url")
  instagramUrl          String?   @map("instagram_url")
  sitioWebUrl           String?   @map("website_url")
  enlacesPersonalizados Json?     @default("[]") @map("custom_links")
  estaActivo            Boolean   @default(true) @map("is_active")
  creadoEn              DateTime  @default(now()) @map("created_at")
  actualizadoEn         DateTime  @updatedAt @map("updated_at")

  usuario               Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  contrataciones        Contratacion[]
  valoraciones          Valoracion[]

  @@map("proyectos_musicales")
}

model Evento {
  id                        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizadorId             String       @map("organizer_id") @db.Uuid
  titulo                    String       @map("title")
  descripcion               String?      @map("description")
  fechaEvento               DateTime     @map("event_date")
  ubicacion                 String       @map("location")
  nombreLugar               String?      @map("venue_name")
  ciudad                    String?      @map("city")
  cantidadMusicosRequerida  Int          @default(1) @map("required_musicians_count")
  cacheOfrecido             Decimal?     @map("offered_cache") @db.Decimal(12, 2)
  estado                    EstadoEvento @default(PUBLICADO) @map("status")
  bannerUrl                 String?      @map("banner_url")
  creadoEn                  DateTime     @default(now()) @map("created_at")
  actualizadoEn             DateTime     @updatedAt @map("updated_at")

  organizador               Usuario      @relation(fields: [organizadorId], references: [id], onDelete: Cascade)
  contrataciones            Contratacion[]
  entradas                  Entrada[]

  @@map("eventos")
}

model Contratacion {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventoId           String             @map("event_id") @db.Uuid
  proyectoMusicalId  String             @map("musical_project_id") @db.Uuid
  organizadorId      String             @map("organizer_id") @db.Uuid
  musicoId           String             @map("musician_id") @db.Uuid
  estado             EstadoContratacion @default(PENDIENTE) @map("status")
  montoPactado       Decimal?           @map("agreed_amount") @db.Decimal(12, 2)
  fechaAcuerdo       DateTime?          @map("agreed_at")
  fechaCancelacion   DateTime?          @map("cancelled_at")
  motivoCancelacion  String?            @map("cancellation_reason")
  creadoPorId        String             @map("created_by") @db.Uuid
  creadoEn           DateTime           @default(now()) @map("created_at")
  actualizadoEn      DateTime           @updatedAt @map("updated_at")

  evento             Evento             @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  proyectoMusical    ProyectoMusical    @relation(fields: [proyectoMusicalId], references: [id], onDelete: Restrict)
  organizador        Usuario            @relation("ContratosOrganizador", fields: [organizadorId], references: [id], onDelete: Restrict)
  musico             Usuario            @relation("ContratosMusico", fields: [musicoId], references: [id], onDelete: Restrict)
  creadoPor          Usuario            @relation("ContratosCreados", fields: [creadoPorId], references: [id], onDelete: Restrict)
  ofertas            Oferta[]
  valoraciones       Valoracion[]

  @@unique([eventoId, proyectoMusicalId])
  @@map("contrataciones")
}

model Oferta {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contratacionId String       @map("contract_id") @db.Uuid
  remitenteId    String       @map("sender_id") @db.Uuid
  monto          Decimal      @map("amount") @db.Decimal(12, 2)
  mensaje        String?      @map("message")
  estado         EstadoOferta @default(PROPUESTA) @map("status")
  creadoEn       DateTime     @default(now()) @map("created_at")
  actualizadoEn  DateTime     @updatedAt @map("updated_at")

  contratacion   Contratacion @relation(fields: [contratacionId], references: [id], onDelete: Cascade)
  remitente      Usuario      @relation(fields: [remitenteId], references: [id], onDelete: Restrict)

  @@map("ofertas")
}

model Valoracion {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contratacionId        String           @map("contract_id") @db.Uuid
  autorId               String           @map("author_id") @db.Uuid
  destinatarioId        String           @map("target_id") @db.Uuid
  proyectoDestinatarioId String?         @map("target_project_id") @db.Uuid
  puntaje               Int              @map("score")
  comentario            String?          @map("comment")
  creadoEn              DateTime         @default(now()) @map("created_at")
  actualizadoEn         DateTime         @updatedAt @map("updated_at")

  contratacion          Contratacion     @relation(fields: [contratacionId], references: [id], onDelete: Cascade)
  autor                 Usuario          @relation("ValoracionesDadas", fields: [autorId], references: [id], onDelete: Restrict)
  destinatario          Usuario          @relation("ValoracionesRecibidas", fields: [destinatarioId], references: [id], onDelete: Restrict)
  proyectoDestinatario  ProyectoMusical? @relation(fields: [proyectoDestinatarioId], references: [id], onDelete: SetNull)

  @@unique([contratacionId, autorId])
  @@map("valoraciones")
}

model Entrada {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventoId            String   @map("event_id") @db.Uuid
  tipoEntrada         String   @default("GENERAL") @map("ticket_type")
  precio              Decimal  @default(0) @map("price") @db.Decimal(12, 2)
  capacidad           Int?     @map("capacity")
  descripcion         String?  @map("description")
  urlCompraExterna    String?  @map("external_purchase_url")
  esGratuita          Boolean  @default(false) @map("is_free")
  creadoEn            DateTime @default(now()) @map("created_at")
  actualizadoEn       DateTime @updatedAt @map("updated_at")

  evento              Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@map("entradas")
}