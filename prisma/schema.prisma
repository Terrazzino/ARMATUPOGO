// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  MUSICIAN
  ORGANIZER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  PENDING
  NEGOTIATING
  AGREED
  CANCELLED
  COMPLETED
  REJECTED
}

enum OfferStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  COUNTERED
}

model ProfileUser {
  id        String   @id @db.Uuid
  email     String   @unique
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  role      UserRole
  avatarUrl String?  @map("avatar_url")
  bio       String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  projects         MusicalProject[]
  events           Event[]
  contractsAsOrg   Contract[]       @relation("OrganizerContracts")
  contractsAsMus   Contract[]       @relation("MusicianContracts")
  contractsCreated Contract[]       @relation("CreatedContracts")
  offersSent       Offer[]
  ratingsGiven     Rating[]         @relation("RatingsGiven")
  ratingsReceived  Rating[]         @relation("RatingsReceived")

  @@map("profile_users")
}

model MusicalProject {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  name             String
  description      String?
  genre            String
  approximateCache Decimal?  @map("approximate_cache") @db.Decimal(12, 2)
  location         String?
  city             String?
  imageUrl         String?   @map("image_url")
  spotifyUrl       String?   @map("spotify_url")
  youtubeUrl       String?   @map("youtube_url")
  instagramUrl     String?   @map("instagram_url")
  websiteUrl       String?   @map("website_url")
  customLinks      Json?     @default("[]") @map("custom_links")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user             ProfileUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts        Contract[]
  ratings          Rating[]

  @@map("musical_projects")
}

model Event {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId            String      @map("organizer_id") @db.Uuid
  title                  String
  description            String?
  eventDate              DateTime    @map("event_date")
  location               String
  venueName              String?     @map("venue_name")
  city                   String?
  requiredMusiciansCount Int         @default(1) @map("required_musicians_count")
  offeredCache           Decimal?    @map("offered_cache") @db.Decimal(12, 2)
  status                 EventStatus @default(PUBLISHED)
  bannerUrl              String?     @map("banner_url")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  organizer              ProfileUser @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  contracts              Contract[]
  tickets                Ticket[]

  @@map("events")
}

model Contract {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String         @map("event_id") @db.Uuid
  musicalProjectId   String         @map("musical_project_id") @db.Uuid
  organizerId        String         @map("organizer_id") @db.Uuid
  musicianId         String         @map("musician_id") @db.Uuid
  status             ContractStatus @default(PENDING)
  agreedAmount       Decimal?       @map("agreed_amount") @db.Decimal(12, 2)
  agreedAt           DateTime?      @map("agreed_at")
  cancelledAt        DateTime?      @map("cancelled_at")
  cancellationReason String?        @map("cancellation_reason")
  createdBy          String         @map("created_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  event              Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  musicalProject     MusicalProject @relation(fields: [musicalProjectId], references: [id], onDelete: Restrict)
  organizer          ProfileUser    @relation("OrganizerContracts", fields: [organizerId], references: [id], onDelete: Restrict)
  musician           ProfileUser    @relation("MusicianContracts", fields: [musicianId], references: [id], onDelete: Restrict)
  creator            ProfileUser    @relation("CreatedContracts", fields: [createdBy], references: [id], onDelete: Restrict)
  offers             Offer[]
  ratings            Rating[]

  @@unique([eventId, musicalProjectId])
  @@map("contracts")
}

model Offer {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId String      @map("contract_id") @db.Uuid
  senderId   String      @map("sender_id") @db.Uuid
  amount     Decimal     @db.Decimal(12, 2)
  message    String?
  status     OfferStatus @default(PROPOSED)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  contract   Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sender     ProfileUser @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@map("offers")
}

model Rating {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId      String          @map("contract_id") @db.Uuid
  authorId        String          @map("author_id") @db.Uuid
  targetId        String          @map("target_id") @db.Uuid
  targetProjectId String?         @map("target_project_id") @db.Uuid
  score           Int
  comment         String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  contract        Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  author          ProfileUser     @relation("RatingsGiven", fields: [authorId], references: [id], onDelete: Restrict)
  target          ProfileUser     @relation("RatingsReceived", fields: [targetId], references: [id], onDelete: Restrict)
  targetProject   MusicalProject? @relation(fields: [targetProjectId], references: [id], onDelete: SetNull)

  @@unique([contractId, authorId])
  @@map("ratings")
}

model Ticket {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId             String   @map("event_id") @db.Uuid
  ticketType          String   @default("GENERAL") @map("ticket_type")
  price               Decimal  @default(0) @db.Decimal(12, 2)
  capacity            Int?
  description         String?
  externalPurchaseUrl String?  @map("external_purchase_url")
  isFree              Boolean  @default(false) @map("is_free")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

